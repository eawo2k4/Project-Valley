<UserControl
    x:Class="Box86_WinUI.Controls.ViewportHostControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#08080A"
    FocusVisualPrimaryThickness="0"
    FocusVisualSecondaryThickness="0"
    IsTabStop="True">

    <Grid x:Name="RootContainer">
        <!-- Direct3D 11 Composition Render Surface -->
        <SwapChainPanel
            x:Name="ViewportSwapChainPanel"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Loaded="OnSwapChainPanelLoaded" />

        <!-- In-Viewport Engine Notification Banner (Replaces Qt Message Boxes) -->
        <InfoBar
            x:Name="ViewportInfoBar"
            IsOpen="False"
            Severity="Warning"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Margin="16,12,16,0"
            IsClosable="True"
            Canvas.ZIndex="100" />


        <!-- Standby / Initializing Overlay -->
        <Grid
            x:Name="StandbyOverlay"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#E0050508"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="44" Height="44" Foreground="#4A90E2" />
                <TextBlock
                    x:Name="StandbyStatusText"
                    Text="Initializing Hardware Emulation…"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#CCCCCC"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Dynamic In-Viewport Telemetry & Activity HUD -->
        <Border
            x:Name="TelemetryHudBorder"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,16,16,0"
            Background="#B0111116"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Speed and FPS Metric -->
                <TextBlock
                    x:Name="SpeedFpsTextBlock"
                    Text="100% (60 FPS)"
                    FontSize="12"
                    FontFamily="Consolas, Cascadia Code, monospace"
                    FontWeight="Bold"
                    Foreground="#A0E0A0"
                    VerticalAlignment="Center" />

                <Rectangle Width="1" Height="14" Fill="#33FFFFFF" />

                <!-- Activity Indicator LEDs -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Floppy Drive LED -->
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" ToolTipService.ToolTip="Floppy Disk (FDD)">
                        <Ellipse x:Name="FloppyLed" Width="8" Height="8" Fill="#333333" Stroke="#222222" StrokeThickness="1" />
                        <TextBlock Text="FDD" FontSize="9" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Hard Disk LED -->
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" ToolTipService.ToolTip="Hard Disk Drive (HDD)">
                        <Ellipse x:Name="HddLed" Width="8" Height="8" Fill="#333333" Stroke="#222222" StrokeThickness="1" />
                        <TextBlock Text="HDD" FontSize="9" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- CD-ROM LED -->
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" ToolTipService.ToolTip="CD-ROM Drive">
                        <Ellipse x:Name="CdLed" Width="8" Height="8" Fill="#333333" Stroke="#222222" StrokeThickness="1" />
                        <TextBlock Text="CD" FontSize="9" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Mouse Capture Status Pill Banner -->
        <Border
            x:Name="CaptureBanner"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Background="#D01B1D28"
            BorderBrush="#445588FF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14,6"
            IsHitTestVisible="False"
            Opacity="0"
            Translation="0,-20,0">
            <Border.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="#66AAFF" />
                <TextBlock
                    x:Name="CaptureBannerText"
                    Text="Mouse Captured — Click Middle Mouse or press Ctrl+Alt to Release"
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="#FFFFFF" />
            </StackPanel>
        </Border>

        <!-- Paused Dimmer Overlay -->
        <Border
            x:Name="PauseOverlay"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#80000000"
            Visibility="Collapsed">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#D0181820"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE769;" FontSize="22" Foreground="#FFAA33" VerticalAlignment="Center" />
                    <TextBlock
                        Text="Emulation Paused"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
