<ContentDialog
    x:Class="Box86_WinUI.Views.ManagerSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Box86_WinUI.Models"
    xmlns:viewmodels="using:Box86_WinUI.ViewModels"
    xmlns:views="using:Box86_WinUI.Views"
    mc:Ignorable="d"
    Title="Manager Settings"
    PrimaryButtonText="Done"
    DefaultButton="Primary"
    CornerRadius="12">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">660</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="640" MaxWidth="760" RowDefinitions="Auto,*" Margin="0,8,0,0">
        <!-- Header Subtitle -->
        <TextBlock Grid.Row="0"
                   Text="Configure global hypervisor directories, system firmware, and emulation environment settings."
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel Spacing="16">
                <!-- Group 0: Core Updates -->
                <views:ManagerSettingsView x:Name="ManagerSettings" RestartTourRequested="OnRestartTourRequested" />

                <!-- Group 1: Firmware & ROMs -->
                <TextBlock Text="System Firmware &amp; ROMs" 
                           FontWeight="SemiBold" 
                           FontSize="14" 
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <!-- System ROMs Path SettingsCard -->
                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <StackPanel MinWidth="220">
                            <TextBlock Text="System ROMs Path" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Location of BIOS and hardware firmware files"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEC07;" />
                    </controls:SettingsCard.HeaderIcon>

                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="200,Auto,Auto" ColumnSpacing="8">
                            <!-- Read-only path TextBox -->
                            <TextBox Grid.Column="0"
                                     Width="200"
                                     Text="{x:Bind ViewModel.RomDirectory, Mode=OneWay}"
                                     IsReadOnly="True"
                                     PlaceholderText="No directory configured"
                                     ToolTipService.ToolTip="{x:Bind ViewModel.RomDirectory, Mode=OneWay}"
                                     VerticalAlignment="Center" />

                            <!-- Browse... button using OpenFolderPicker -->
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Command="{x:Bind ViewModel.BrowseRomDirectoryCommand}"
                                    VerticalAlignment="Center" />

                            <!-- Open in Explorer icon button -->
                            <Button Grid.Column="2"
                                    Command="{x:Bind ViewModel.OpenRomDirectoryInExplorerCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRomDirectoryPresent, Mode=OneWay}"
                                    ToolTipService.ToolTip="Open in Explorer"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    VerticalAlignment="Center"
                                    Padding="8,6">
                                <FontIcon Glyph="&#xED25;" FontSize="14" />
                            </Button>
                        </Grid>

                        <!-- Inline validation row: one of scanning / valid / invalid, driven by ViewModel.RomValidationState -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" HorizontalAlignment="Left">
                            <ProgressRing Width="14" Height="14" IsActive="True" VerticalAlignment="Center"
                                          Visibility="{x:Bind ViewModel.RomValidatingVisibility, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      Visibility="{x:Bind ViewModel.RomValidVisibility, Mode=OneWay}" />
                            <FontIcon Glyph="&#xEA39;" FontSize="14" VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                      Visibility="{x:Bind ViewModel.RomInvalidVisibility, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RomValidationStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Group 2: Virtual Machines Storage -->
                <TextBlock Text="Virtual Machine Storage" 
                           FontWeight="SemiBold" 
                           FontSize="14" 
                           Margin="0,10,0,0"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <StackPanel MinWidth="220">
                            <TextBlock Text="Virtual Machines Folder" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Default filesystem location where created virtual machine folders reside"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Grid ColumnDefinitions="240,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBox Grid.Column="0"
                                 Width="240"
                                 Text="{x:Bind DefaultVmDirectory, Mode=OneTime}"
                                 IsReadOnly="True"
                                 ToolTipService.ToolTip="{x:Bind DefaultVmDirectory, Mode=OneTime}"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.OpenVmsFolderCommand}"
                                ToolTipService.ToolTip="Open in Explorer"
                                Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Padding="8,6">
                            <FontIcon Glyph="&#xED25;" FontSize="14" />
                        </Button>
                    </Grid>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
