<ContentDialog
    x:Class="Box86_WinUI.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CloseButtonText="Close"
    DefaultButton="Close"
    CornerRadius="8">

    <!-- MaxWidth as a plain element property doesn't reliably recenter the visible card within its
         popup - overriding the ContentDialogMaxWidth theme resource instead is what
         ManagerSettingsDialog/MachineSettingsDialog already do and actually centers correctly. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Margin="0,4,0,0">
        <!-- Header: app icon + title stack -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Image Grid.Column="0" Source="ms-appx:///Assets/WelcomeHero.png"
                   Width="64" Height="64" Stretch="Uniform" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="86Box VM Manager" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    <Border x:Name="ChannelBadge" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock x:Name="ChannelBadgeText" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Cycle-accurate x86 system hypervisor and emulator"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="EngineText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Credits + license -->
        <StackPanel Spacing="4">
            <TextBlock Text="86Box is developed by Miran Grca, Fred N. van Kempen, Jasmine Iwanek, and the 86Box team."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="Licensed under the GNU General Public License, version 2."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Official resources -->
        <StackPanel Orientation="Horizontal" Spacing="4">
            <HyperlinkButton Content="GitHub" Click="OnGitHubClicked" />
            <HyperlinkButton Content="Documentation" Click="OnDocumentationClicked" />
            <HyperlinkButton Content="Community Discord" Click="OnDiscordClicked" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
