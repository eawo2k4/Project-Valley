<UserControl
    x:Class="Box86_WinUI.Views.DeviceConfigPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer MaxHeight="440" MinWidth="420" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Padding="0,4,12,0">
            <TextBlock x:Name="IntroText" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <!-- Schema-driven controls (ComboBox / CheckBox per setting) are generated here -->
            <StackPanel x:Name="SettingsHost" Spacing="12" />

            <!-- Monitor EDID -->
            <StackPanel x:Name="EdidPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Display profile" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="EdidProfileCombo" HorizontalAlignment="Stretch" SelectionChanged="OnEdidProfileChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="EdidBrowseButton" Content="Load EDID file…" Click="OnBrowseEdidClicked">
                        <Button.Resources />
                    </Button>
                    <TextBlock x:Name="EdidPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="260" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="NoOptionsText" Visibility="Collapsed" TextWrapping="Wrap"
                       Text="This device has no configurable options." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
