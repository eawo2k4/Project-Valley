<ContentDialog
    x:Class="Box86_WinUI.Views.NewVMWizardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Box86_WinUI.Models"
    xmlns:viewmodels="using:Box86_WinUI.ViewModels"
    mc:Ignorable="d"
    Title="Create a virtual machine"
    PrimaryButtonText="Continue"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CloseButtonClick="OnCloseButtonClick"
    CornerRadius="8">

    <!-- MaxWidth as a plain element property (as this used to be set) doesn't reliably recenter the
         visible card within its popup - overriding the ContentDialogMaxWidth theme resource instead
         is what ManagerSettingsDialog/MachineSettingsDialog already do and actually centers correctly. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">520</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Margin="0,4,0,0">
        <!-- Secondary descriptive text block -->
        <TextBlock Text="Choose how you want to set up your virtual machine in 86Box."
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />

        <!-- Modern Selection Cards -->
        <StackPanel Spacing="8">
            <!-- Option 1: Custom configuration -->
            <controls:SettingsCard Header="Custom configuration"
                                   Description="Configure motherboard architecture, CPU, and peripherals from scratch"
                                   IsClickEnabled="True"
                                   Click="OnCustomConfigCardClicked">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE70F;" />
                </controls:SettingsCard.HeaderIcon>
                <RadioButton IsChecked="{x:Bind ViewModel.IsNewConfiguration, Mode=TwoWay}"
                             GroupName="CreationMode" />
            </controls:SettingsCard>

            <!-- Option 2: Import existing -->
            <controls:SettingsCard Header="Import existing"
                                   Description="Attach an existing 86box.cfg file or virtual machine directory"
                                   IsClickEnabled="True"
                                   Click="OnImportExistingCardClicked">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B5;" />
                </controls:SettingsCard.HeaderIcon>
                <RadioButton IsChecked="{x:Bind ViewModel.IsExistingConfiguration, Mode=TwoWay}"
                             GroupName="CreationMode" />
            </controls:SettingsCard>
        </StackPanel>

        <!-- VM Name TextBox directly below the selection -->
        <StackPanel Spacing="6">
            <TextBlock Text="Virtual machine name" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox Text="{x:Bind ViewModel.SystemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="e.g. Windows 98 PC" />
            <TextBlock Text="Please enter a virtual machine name"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       FontSize="11"
                       Visibility="{x:Bind ViewModel.HasSystemNameError, Mode=OneWay}" />
        </StackPanel>

        <!-- Existing Configuration Path (Visible when Import existing is selected) -->
        <StackPanel Spacing="6"
                    Visibility="{x:Bind ViewModel.IsExistingConfiguration, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Existing 86box.cfg or folder" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{x:Bind ViewModel.ExistingConfigPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Select an 86box.cfg file or VM directory" />
                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseExistingConfigClicked" />
            </Grid>
        </StackPanel>

        <!-- Error InfoBar -->
        <InfoBar Severity="Error"
                 IsOpen="{x:Bind ViewModel.HasCreationError, Mode=OneWay}"
                 Title="Cannot create machine"
                 Message="{x:Bind ViewModel.CreationError, Mode=OneWay}"
                 IsClosable="False" />
    </StackPanel>
</ContentDialog>
