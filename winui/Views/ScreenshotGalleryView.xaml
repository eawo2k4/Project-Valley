<UserControl
    x:Class="Box86_WinUI.Views.ScreenshotGalleryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Box86_WinUI.Models"
    xmlns:viewmodels="using:Box86_WinUI.ViewModels"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <!-- 1. Top Action Bar: Clean Windows 11 Title + Compact Action Buttons -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE722;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="Display Captures" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Action Buttons: Compact Subtle Buttons with Tooltips (Windows 11 pattern) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <!-- Capture Button -->
                    <Button Style="{StaticResource SubtleButtonStyle}" 
                            Command="{x:Bind ViewModel.CaptureScreenshotCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Take Screenshot"
                            Padding="6,6">
                        <FontIcon Glyph="&#xE722;" FontSize="13" />
                    </Button>

                    <!-- Copy Button -->
                    <Button Style="{StaticResource SubtleButtonStyle}" 
                            Command="{x:Bind ViewModel.CopyScreenshotCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.HasScreenshots, Mode=OneWay}"
                            ToolTipService.ToolTip="Copy Image to Clipboard"
                            Padding="6,6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                    </Button>

                    <!-- Open Folder Button -->
                    <Button Style="{StaticResource SubtleButtonStyle}" 
                            Command="{x:Bind ViewModel.OpenScreenshotsFolderCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Open Captures Folder in Explorer"
                            Padding="6,6">
                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                    </Button>

                    <!-- Overflow Flyout for Delete and Export -->
                    <Button Style="{StaticResource SubtleButtonStyle}" 
                            ToolTipService.ToolTip="More Options"
                            Padding="6,6">
                        <FontIcon Glyph="&#xE712;" FontSize="13" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Export Image As..." Click="OnExportClicked" IsEnabled="{x:Bind ViewModel.HasScreenshots, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete Capture" Click="OnDeleteClicked" IsEnabled="{x:Bind ViewModel.HasScreenshots, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Centered Uniform Preview Viewport -->
            <Border Grid.Row="1" 
                    Height="200"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <!-- Populated Image Preview -->
                    <Grid Visibility="{x:Bind ViewModel.HasScreenshots, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image Source="{x:Bind ViewModel.SelectedScreenshot.ImageSource, Mode=OneWay}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                        <!-- Acrylic/Mica Top-Left Overlay Badge -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7B7;" FontSize="10" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedScreenshot.DisplayMode, Mode=OneWay}" 
                                           Style="{StaticResource CaptionTextBlockStyle}" 
                                           FontSize="10" 
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Standard Fluent Empty State (Camera glyph + "No captures yet") -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24"
                                Visibility="{x:Bind ViewModel.HasScreenshots, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                        <Border Width="48" Height="48" CornerRadius="24"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE722;" FontSize="20" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No captures yet" 
                                   Style="{StaticResource BodyStrongTextBlockStyle}" 
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Take a screenshot while running or click Capture" 
                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Horizontal Thumbnail Filmstrip Strip -->
            <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.HasScreenshots, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListView ItemsSource="{x:Bind ViewModel.Screenshots, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedScreenshot, Mode=TwoWay}"
                          SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:VMScreenshot">
                            <Border Width="72" Height="48" 
                                    CornerRadius="4" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    ToolTipService.ToolTip="{x:Bind FormattedTimestamp}">
                                <Image Source="{x:Bind ImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Border>
</UserControl>
