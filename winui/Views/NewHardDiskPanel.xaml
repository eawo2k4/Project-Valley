<UserControl
    x:Class="Box86_WinUI.Views.NewHardDiskPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer MaxHeight="520" MinWidth="460" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,4,12,0">

            <!-- Disk name (the file is created in the machine's own folder) -->
            <StackPanel Spacing="4">
                <TextBox x:Name="FileNameBox" Header="Disk name" PlaceholderText="hdd_02.vhd" TextChanged="OnFileNameChanged" />
                <TextBlock x:Name="LocationText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Size and format -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <NumberBox x:Name="SizeBox" Header="Size (MB)" Minimum="1" Maximum="2097152"
                           SmallChange="1" LargeChange="100" SpinButtonPlacementMode="Inline"
                           ValueChanged="OnSizeChanged" />
                <ComboBox x:Name="FormatCombo" Grid.Column="1" Header="Image format" HorizontalAlignment="Stretch"
                          SelectionChanged="OnFormatChanged">
                    <ComboBoxItem Content="Dynamic VHD (.vhd)" />
                    <ComboBoxItem Content="Raw image (.img)" />
                </ComboBox>
            </Grid>

            <!-- Bus and channel: channels another drive already uses are disabled -->
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <ComboBox x:Name="BusCombo" Header="Bus" HorizontalAlignment="Stretch" SelectionChanged="OnBusChanged" />
                    <ComboBox x:Name="ChannelCombo" Grid.Column="1" Header="Channel" HorizontalAlignment="Stretch"
                              DisplayMemberPath="Display" SelectedValuePath="Name">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="AutoChannelText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Drive profile and geometry (collapsed by default) -->
            <Expander Header="Drive profile and geometry" IsExpanded="False" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <ComboBox x:Name="ProfileCombo" Header="Drive profile" HorizontalAlignment="Stretch"
                              SelectionChanged="OnProfileChanged" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <NumberBox x:Name="CylindersBox" Header="Cylinders" Minimum="1" Maximum="266305"
                                   SpinButtonPlacementMode="Compact" ValueChanged="OnChsChanged" />
                        <NumberBox x:Name="HeadsBox" Grid.Column="1" Header="Heads" Minimum="1" Maximum="255"
                                   SpinButtonPlacementMode="Compact" ValueChanged="OnChsChanged" />
                        <NumberBox x:Name="SectorsBox" Grid.Column="2" Header="Sectors" Minimum="1" Maximum="255"
                                   SpinButtonPlacementMode="Compact" ValueChanged="OnChsChanged" />
                    </Grid>
                    <TextBlock x:Name="GeometrySummary" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>

            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="False" Title="Could not create the disk" />
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
