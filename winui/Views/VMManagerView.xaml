<UserControl
    x:Class="Box86_WinUI.Views.VMManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Box86_WinUI.Models"
    xmlns:viewmodels="using:Box86_WinUI.ViewModels"
    xmlns:views="using:Box86_WinUI.Views"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto" Background="Transparent">
        <!-- ========================================== -->
        <!-- Top CommandBar (Windows 11 Fluent Standard) -->
        <!-- ========================================== -->
        <Border Grid.Row="0" 
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" 
                Padding="12,6">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Left Action Toolbar -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- New Machine… -->
                    <Button Style="{StaticResource SubtleButtonStyle}" Click="OnNewVMClicked" Padding="8,6" ToolTipService.ToolTip="New machine…">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="New machine…" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" />

                    <!-- Primary Action: Start (Shown when Stopped) -->
                    <Button Style="{StaticResource AccentButtonStyle}" 
                            Command="{x:Bind ViewModel.StartVMCommand}" 
                            CommandParameter="{x:Bind ViewModel.SelectedVM, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsVmSelected, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsSelectedVMRunning, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                            ToolTipService.ToolTip="Start virtual machine" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                            <TextBlock Text="Start" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Primary Action: Shut down (Shown when Running) -->
                    <Button Style="{StaticResource AccentButtonStyle}" 
                            Command="{x:Bind ViewModel.StopVMCommand}" 
                            CommandParameter="{x:Bind ViewModel.SelectedVM, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsSelectedVMRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTipService.ToolTip="Shut down virtual machine" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71A;" FontSize="12" />
                            <TextBlock Text="Shut down" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Pause / Resume (Shown when Running) -->
                    <Button Style="{StaticResource SubtleButtonStyle}" 
                            Command="{x:Bind ViewModel.TogglePauseCommand}" 
                            CommandParameter="{x:Bind ViewModel.SelectedVM, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsSelectedVMRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTipService.ToolTip="Pause / Resume" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE769;" FontSize="13" />
                            <TextBlock Text="Pause" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Hard Reset -->
                    <Button Style="{StaticResource SubtleButtonStyle}" 
                            Command="{x:Bind ViewModel.HardResetCommand}" 
                            CommandParameter="{x:Bind ViewModel.SelectedVM, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsSelectedMachineRunning, Mode=OneWay}"
                            ToolTipService.ToolTip="Hard reset" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE777;" FontSize="13" />
                            <TextBlock Text="Hard reset" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Ctrl+Alt+Del -->
                    <Button Style="{StaticResource SubtleButtonStyle}" 
                            Command="{x:Bind ViewModel.SendCadCommand}" 
                            CommandParameter="{x:Bind ViewModel.SelectedVM, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsSelectedMachineRunning, Mode=OneWay}"
                            ToolTipService.ToolTip="Ctrl+Alt+Del" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE765;" FontSize="13" />
                            <TextBlock Text="Ctrl+Alt+Del" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" />

                    <!-- Settings… -->
                    <Button Style="{StaticResource SubtleButtonStyle}" 
                            Command="{x:Bind ViewModel.ShowSettingsCommand}" 
                            CommandParameter="{x:Bind ViewModel.SelectedVM, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsVmSelected, Mode=OneWay}"
                            ToolTipService.ToolTip="Machine Settings…" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                            <TextBlock Text="Settings…" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Tools Strip -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Style="{StaticResource SubtleButtonStyle}" 
                            Command="{x:Bind ViewModel.LoadVMsCommand}" 
                            ToolTipService.ToolTip="Reload machines" Padding="8,6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>

                    <Button Style="{StaticResource SubtleButtonStyle}" 
                            ToolTipService.ToolTip="Tools" Padding="8,6">
                        <FontIcon Glyph="&#xE712;" FontSize="13" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Settings" Click="OnOpenManagerSettingsClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Open virtual machines folder" Command="{x:Bind ViewModel.OpenVmsFolderCommand}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED25;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Check for updates" Click="OnCheckUpdatesClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Documentation" Click="OnDocumentationClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="About 86Box" Click="OnAbout86BoxClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Exit" Click="OnExitClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- Main Body: Left VM List + Right Inspector -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" ColumnDefinitions="*,520" Background="Transparent">
            <!-- Left Column: Missing ROM Warning + Search Bar + ListView -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="16,12,12,12">
                <!-- Missing ROMs In-App Warning InfoBar -->
                <InfoBar Grid.Row="0"
                         IsOpen="{x:Bind ViewModel.IsRomPathMissing, Mode=OneWay}"
                         Severity="Warning"
                         Title="System firmware path required"
                         Message="A valid 86Box ROMs directory must be configured to emulate machines and hardware."
                         IsClosable="False"
                         Margin="0,0,0,10">
                    <InfoBar.ActionButton>
                        <Button Content="Configure Settings" Click="OnOpenManagerSettingsClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Search Box directly above list -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <AutoSuggestBox x:Name="VmSearchBox"
                                    PlaceholderText="Search virtual machines..."
                                    QueryIcon="Find"
                                    MaxWidth="320"
                                    HorizontalAlignment="Left"
                                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="OnVmSearchBoxTextChanged"
                                    QuerySubmitted="OnVmSearchBoxQuerySubmitted" />

                    <DropDownButton Style="{ThemeResource SubtleDropDownButtonStyle}"
                                     Content="Sort"
                                     ToolTipService.ToolTip="Sort the machine list">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Name" Click="OnSortByNameClicked" />
                                <MenuFlyoutItem Text="Status" Click="OnSortByStatusClicked" />
                                <MenuFlyoutItem Text="Recently used" Click="OnSortByRecentClicked" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <!-- Rich Fluent Card ListView -->
                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.FilteredVMs, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedVM, Mode=TwoWay}"
                          SelectionMode="Single"
                          DoubleTapped="OnListViewDoubleTapped"
                          HorizontalAlignment="Stretch"
                          Padding="0,0,4,0">
                    <ListView.Resources>
                        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">True</x:Boolean>
                        <CornerRadius x:Key="ListViewItemSelectionIndicatorCornerRadius">1.5</CornerRadius>
                        <StaticResource x:Key="ListViewItemSelectionIndicatorBrush" ResourceKey="AccentFillColorDefaultBrush" />
                        <StaticResource x:Key="ListViewItemSelectionIndicatorPointerOverBrush" ResourceKey="AccentFillColorDefaultBrush" />
                        <StaticResource x:Key="ListViewItemSelectionIndicatorPressedBrush" ResourceKey="AccentFillColorDefaultBrush" />
                    </ListView.Resources>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ContentThemeTransition />
                            <ReorderThemeTransition />
                            <EntranceThemeTransition IsStaggeringEnabled="False" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Padding" Value="16,12" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:VirtualMachine">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"
                                  Background="Transparent"
                                  PointerEntered="OnCardPointerEntered"
                                  PointerExited="OnCardPointerExited">
                                <!-- Clean Computer FontIcon (vertically centered, 20px, unboxed with 12px right margin) -->
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE7F4;"
                                          FontSize="20"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <!-- Header: VM Name (SubtitleTextBlockStyle) + Specs summary string (CaptionTextBlockStyle) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" 
                                               Style="{StaticResource SubtitleTextBlockStyle}" 
                                               FontWeight="SemiBold" 
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind SpecsSummary, Mode=OneWay}" 
                                               Style="{StaticResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Right: Semantic Status Badge + Hover Quick-Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <!-- Semantic Status Badge paired with caption ("Running" / "Stopped") -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <InfoBadge Style="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToInfoBadgeStyleConverter}}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ProcessStatusString, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToForegroundBrushConverter}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Quick Actions (Start/Stop and More "•••") -->
                                    <StackPanel x:Name="QuickActionsPanel"
                                                Orientation="Horizontal" 
                                                Spacing="4" 
                                                VerticalAlignment="Center"
                                                Opacity="0.3">
                                        <!-- Start Quick Action (Stopped State) -->
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Padding="6,4"
                                                ToolTipService.ToolTip="Start"
                                                Click="OnItemStartClicked"
                                                DataContext="{x:Bind}"
                                                Visibility="{x:Bind IsStopped, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Button>

                                        <!-- Shut Down Quick Action (Running State) -->
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Padding="6,4"
                                                ToolTipService.ToolTip="Shut down"
                                                Click="OnItemStopClicked"
                                                DataContext="{x:Bind}"
                                                Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>

                                        <!-- More Options "•••" -->
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Padding="6,4"
                                                ToolTipService.ToolTip="More options">
                                            <FontIcon Glyph="&#xE712;" FontSize="12" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <!-- Execution Commands: Stopped State -->
                                                    <MenuFlyoutItem Text="Start" DataContext="{x:Bind}" Click="OnItemStartClicked"
                                                                    Visibility="{x:Bind IsStopped, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>

                                                    <!-- Execution Commands: Running State -->
                                                    <MenuFlyoutItem Text="Shut down" DataContext="{x:Bind}" Click="OnItemStopClicked"
                                                                    Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Pause" DataContext="{x:Bind}" Click="OnItemPauseClicked"
                                                                    Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE769;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Restart" DataContext="{x:Bind}" Click="OnItemResetClicked"
                                                                    Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>

                                                    <MenuFlyoutSeparator />

                                                    <!-- Configuration Options -->
                                                    <MenuFlyoutItem Text="Settings…" DataContext="{x:Bind}" Click="OnItemSettingsClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Open in File Explorer" DataContext="{x:Bind}" Click="OnItemOpenFolderClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED25;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Open configuration file" DataContext="{x:Bind}" Click="OnItemOpenConfigFileClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Export configuration..." DataContext="{x:Bind}" Click="OnItemExportConfigClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>

                                                    <MenuFlyoutSeparator />

                                                    <!-- Deletion -->
                                                    <MenuFlyoutItem Text="Delete" DataContext="{x:Bind}" Click="OnItemDeleteClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right-Click Context Menu -->
                                <Grid.ContextFlyout>
                                    <MenuFlyout x:Name="MachineContextMenu">
                                        <!-- Execution Commands: Stopped State -->
                                        <MenuFlyoutItem Text="Start" DataContext="{x:Bind}" Click="OnItemStartClicked"
                                                        Visibility="{x:Bind IsStopped, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <!-- Execution Commands: Running State -->
                                        <MenuFlyoutItem Text="Shut down" DataContext="{x:Bind}" Click="OnItemStopClicked"
                                                        Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Pause" DataContext="{x:Bind}" Click="OnItemPauseClicked"
                                                        Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE769;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Restart" DataContext="{x:Bind}" Click="OnItemResetClicked"
                                                        Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <MenuFlyoutSeparator />

                                        <!-- Configuration Options -->
                                        <MenuFlyoutItem Text="Settings…" DataContext="{x:Bind}" Click="OnItemSettingsClicked">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open in File Explorer" DataContext="{x:Bind}" Click="OnItemOpenFolderClicked">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED25;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open configuration file" DataContext="{x:Bind}" Click="OnItemOpenConfigFileClicked">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Export configuration..." DataContext="{x:Bind}" Click="OnItemExportConfigClicked">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <MenuFlyoutSeparator />

                                        <!-- Deletion -->
                                        <MenuFlyoutItem Text="Delete" DataContext="{x:Bind}" Click="OnItemDeleteClicked">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Right Column: Dedicated Inspector Pane -->
            <Border Grid.Column="1" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <!-- Empty State Placeholder (when no VM selected) -->
                    <StackPanel Spacing="8"
                                MaxWidth="360"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.SelectedVM, Mode=OneWay, Converter={StaticResource InvertedNullToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE7F4;"
                                  FontSize="56"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8" />
                        <TextBlock Text="No virtual machine selected"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Text="Select a virtual machine from the list or create a new one to view its configuration and status."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnNewVMClicked"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Create machine" />
                                </StackPanel>
                            </Button>
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenVmsFolderCommand}"
                                             Content="Open in File Explorer"
                                             HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Populated Details Inspector: Entrance animated container -->
                    <Grid x:Name="InspectorContainer"
                          Visibility="{x:Bind ViewModel.SelectedVM, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="12"/>
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>

                        <ScrollViewer x:Name="InspectorScrollViewer" Padding="20,16,20,16">
                            <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                            <!-- 1. Header: VM Title + Status InfoBadge + Quick Actions -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedVM.Name, Mode=OneWay}" 
                                               Style="{StaticResource TitleTextBlockStyle}" 
                                               FontSize="20"
                                               FontWeight="SemiBold" 
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <InfoBadge Style="{x:Bind ViewModel.SelectedVM.Status, Mode=OneWay, Converter={StaticResource StatusToInfoBadgeStyleConverter}}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedVM.ProcessStatusString, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{x:Bind ViewModel.SelectedVM.Status, Mode=OneWay, Converter={StaticResource StatusToForegroundBrushConverter}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Command="{x:Bind ViewModel.ShowSettingsCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind ViewModel.SelectedVM, Mode=OneWay}"
                                            ToolTipService.ToolTip="Machine Settings…" Padding="6">
                                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind ViewModel.SelectedVM, Mode=OneWay}"
                                            ToolTipService.ToolTip="Open VM folder" Padding="6">
                                        <FontIcon Glyph="&#xED25;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Command="{x:Bind ViewModel.OpenConfigFileCommand, Mode=OneWay}"
                                            CommandParameter="{x:Bind ViewModel.SelectedVM, Mode=OneWay}"
                                            ToolTipService.ToolTip="Open configuration file"
                                            AutomationProperties.Name="Open configuration file" Padding="6">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 2. Cleanly Docked Screenshot Frame (Below VM Title) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="180"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <!-- Screenshot image if present -->
                                    <Image Source="{x:Bind ViewModel.SelectedScreenshot.ImageSource, Mode=OneWay}"
                                           Stretch="Uniform" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.HasScreenshots, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    
                                    <!-- Empty placeholder when no screenshot -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                                Visibility="{x:Bind ViewModel.HasScreenshots, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No screenshot available" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Screenshot Navigation Controls Overlay -->
                                    <Grid VerticalAlignment="Bottom" Margin="8"
                                          Visibility="{x:Bind ViewModel.HasScreenshots, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4" Padding="2" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Width="28" Height="24" Padding="0"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Command="{x:Bind ViewModel.PreviousScreenshotCommand, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.HasScreenshots, Mode=OneWay}"
                                                        ToolTipService.ToolTip="Previous Screenshot">
                                                    <FontIcon Glyph="&#xE76B;" FontSize="10" />
                                                </Button>
                                                <Button Width="28" Height="24" Padding="0"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Command="{x:Bind ViewModel.NextScreenshotCommand, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.HasScreenshots, Mode=OneWay}"
                                                        ToolTipService.ToolTip="Next Screenshot">
                                                    <FontIcon Glyph="&#xE76C;" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 3. Hardware Specs: Structured Read-Only SettingsCards in SettingsExpander groups -->
                            <StackPanel Spacing="8">

                                <!-- Group A: "System" (Motherboard, CPU, Memory) -->
                                <controls:SettingsExpander Header="System" 
                                                           Description="{x:Bind ViewModel.CurrentMachine.PlatformName, Mode=OneWay}"
                                                           IsExpanded="True">
                                    <controls:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE7F4;" />
                                    </controls:SettingsExpander.HeaderIcon>
                                    <controls:SettingsExpander.Items>
                                        <controls:SettingsCard Header="Motherboard">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedVM.MachineModel, Mode=OneWay}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </controls:SettingsCard>
                                        <controls:SettingsCard Header="CPU">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedVM.Cpu, Mode=OneWay}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </controls:SettingsCard>
                                        <controls:SettingsCard Header="Memory">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedVM.MemoryDisplay, Mode=OneWay}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </controls:SettingsCard>
                                    </controls:SettingsExpander.Items>
                                </controls:SettingsExpander>

                                <!-- Group B: "Display & Audio" (Video adapter, Sound card) -->
                                <controls:SettingsExpander Header="Display &amp; Audio" 
                                                           Description="Graphics adapter and sound controller"
                                                           IsExpanded="True">
                                    <controls:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE7F3;" />
                                    </controls:SettingsExpander.HeaderIcon>
                                    <controls:SettingsExpander.Items>
                                        <controls:SettingsCard Header="Video Adapter">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedVM.VideoCard, Mode=OneWay}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </controls:SettingsCard>
                                        <controls:SettingsCard Header="Sound Card">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedVM.SoundCard, Mode=OneWay}"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </controls:SettingsCard>
                                    </controls:SettingsExpander.Items>
                                </controls:SettingsExpander>

                                <!-- Group C: "Drives" (Attached FDD and CD images) -->
                                <controls:SettingsExpander Header="Drives" 
                                                           Description="Attached media images"
                                                           IsExpanded="True">
                                    <controls:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xEDA2;" />
                                    </controls:SettingsExpander.HeaderIcon>
                                    <controls:SettingsExpander.Items>
                                        <controls:SettingsCard Header="Floppy Disk (FDD)">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74E;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedVM.FloppyDisplayName, Mode=OneWay}"
                                                           Style="{StaticResource BodyTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           ToolTipService.ToolTip="{x:Bind ViewModel.SelectedVM.MountedFloppyPath, Mode=OneWay}" />
                                            </StackPanel>
                                        </controls:SettingsCard>
                                        <controls:SettingsCard Header="CD-ROM (ISO)">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE958;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedVM.CdromDisplayName, Mode=OneWay}"
                                                           Style="{StaticResource BodyTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           ToolTipService.ToolTip="{x:Bind ViewModel.SelectedVM.MountedCdromPath, Mode=OneWay}" />
                                            </StackPanel>
                                        </controls:SettingsCard>
                                    </controls:SettingsExpander.Items>
                                </controls:SettingsExpander>

                                <!-- Configuration File Card -->
                                <controls:SettingsCard ActionIcon="{x:Null}">
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <controls:SettingsCard.Header>
                                        <StackPanel MinWidth="200" VerticalAlignment="Center">
                                            <TextBlock Text="Configuration file" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Open 86box.cfg in default text editor"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Command="{x:Bind ViewModel.OpenConfigFileCommand, Mode=OneWay}"
                                                CommandParameter="{x:Bind ViewModel.SelectedVM, Mode=OneWay}"
                                                ToolTipService.ToolTip="Open 86box.cfg in default text editor"
                                                AutomationProperties.Name="Open configuration file">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="13" />
                                                <TextBlock Text="Open file" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind ViewModel.ExportConfigFileCommand, Mode=OneWay}"
                                                CommandParameter="{x:Bind ViewModel.SelectedVM, Mode=OneWay}"
                                                ToolTipService.ToolTip="Export configuration file"
                                                AutomationProperties.Name="Export configuration...">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                                                <TextBlock Text="Export…" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </controls:SettingsCard>
                            </StackPanel>

                            <!-- 4. Notes: Expandable Expander at the bottom of the inspector -->
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        <TextBlock Text="Notes" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <TextBox Text="{x:Bind ViewModel.SelectedVM.Notes, Mode=TwoWay}"
                                         PlaceholderText="Type notes for this virtual machine here…"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="100"
                                         MaxHeight="200"
                                         Margin="0,4,0,0" />
                            </Expander>

                            <!-- 5. Centered Detail Status text at the bottom -->
                            <TextBlock Text="{x:Bind ViewModel.SelectedVM.DetailStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />

                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- Bottom Status Bar (statusbar: statusLeft & statusRight) -->
        <!-- ========================================== -->
        <Border Grid.Row="2"
                Height="32"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <!-- Status Left: statusLeft -->
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />

                <!-- Status Right: statusRight strictly formatted as "VMs: %1 total" -->
                <TextBlock Text="{x:Bind ViewModel.VmTotalCountText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
