                            </Grid>

                            <!-- COM4 -->
                            <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <CheckBox Grid.Column="0" Content="COM4:" IsChecked="{x:Bind ViewModel.EnableCom4, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.ComDevices}"
                                          SelectedItem="{x:Bind ViewModel.SelectedCom4Device, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.EnableCom4, Mode=OneWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85"
                                        IsEnabled="{x:Bind ViewModel.EnableCom4, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 7. Storage Controllers Category -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsStorageControllersCategory, Mode=OneWay}">
                        <!-- Category Header -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEC07;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Storage controllers" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,-4,0,8" />

                        <!-- Subtab Switcher: General / SCSI controllers -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Click="OnSelectStorageSubTab0" Padding="12,6" Style="{StaticResource SubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEC07;" FontSize="14" />
                                        <TextBlock Text="General" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnSelectStorageSubTab1" Padding="12,6" Style="{StaticResource SubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEDA2;" FontSize="14" />
                                        <TextBlock Text="SCSI controllers" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Subtab 0: General -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsStorageSubTab0, Mode=OneWay}">
                            <!-- Floppy disk controller -->
                            <controls:SettingsCard Header="Floppy disk controller"
                                                   Description="Motherboard or expansion floppy disk controller">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE958;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinWidth="340">
                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.FloppyControllers, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedFloppyController, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="Configure" />
                                </Grid>
                            </controls:SettingsCard>

                            <!-- CD-ROM controller -->
                            <controls:SettingsCard Header="CD-ROM controller"
                                                   Description="Proprietary / ATAPI CD-ROM interface adapter">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEC50;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinWidth="340">
                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.CdromControllers, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedCdromController, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="Configure" />
                                </Grid>
                            </controls:SettingsCard>

                            <!-- Hard disk controllers Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="Hard disk controllers" FontWeight="SemiBold" FontSize="14" />
                                    </StackPanel>

                                    <!-- HDC 1 -->
                                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Controller 1:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.HdControllers, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedHdController1, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Content="Configure" MinWidth="84" />
                                    </Grid>

                                    <!-- HDC 2 -->
                                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Controller 2:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.HdControllersExtra, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedHdController2, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Content="Configure" MinWidth="84" />
                                    </Grid>

                                    <!-- HDC 3 -->
                                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Controller 3:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.HdControllersExtra, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedHdController3, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Content="Configure" MinWidth="84" />
                                    </Grid>

                                    <!-- HDC 4 -->
                                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Controller 4:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.HdControllersExtra, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedHdController4, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Content="Configure" MinWidth="84" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Cassette CheckBox -->
                            <CheckBox Content="Cassette" IsChecked="{x:Bind ViewModel.EnableCassette, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Subtab 1: SCSI controllers (matching 86Box screenshot directly!) -->
                        <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsStorageSubTab1, Mode=OneWay}">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="14">
                                    <!-- SCSI 1 -->
                                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Controller 1:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.ScsiControllers, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedScsiController1, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Content="Configure" MinWidth="84" />
                                    </Grid>

                                    <!-- SCSI 2 -->
                                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Controller 2:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.ScsiControllers, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedScsiController2, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Content="Configure" MinWidth="84" />
                                    </Grid>

                                    <!-- SCSI 3 -->
                                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Controller 3:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.ScsiControllers, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedScsiController3, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Content="Configure" MinWidth="84" />
                                    </Grid>

                                    <!-- SCSI 4 -->
                                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Controller 4:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.ScsiControllers, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedScsiController4, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Content="Configure" MinWidth="84" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 8. Hard Disks Category -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsHardDisksCategory, Mode=OneWay}">
                        <!-- Category Header -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Hard disks" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,-4,0,8" />

                        <!-- Hard Disks Table Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="0">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Table Header -->
                                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="8,8,0,0">
                                    <Grid ColumnDefinitions="110,*,190,220" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Text="Bus" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Column="1" Text="File" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Column="2" Text="Geometry" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Column="3" Text="Model" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </Border>

                                <!-- Table Content / ListView -->
                                <ListView Grid.Row="1"
                                          ItemsSource="{x:Bind ViewModel.HardDisks}"
                                          SelectedItem="{x:Bind ViewModel.SelectedHardDisk, Mode=TwoWay}"
                                          MinHeight="140" MaxHeight="220"
                                          SelectionMode="Single"
                                          Padding="0">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="12,6" />
                                            <Setter Property="MinHeight" Value="36" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:HardDiskEntry">
                                            <Grid ColumnDefinitions="110,*,190,220" ColumnSpacing="12" VerticalAlignment="Center">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xECCA;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="{x:Bind BusChannelDisplay, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ImagePath, Mode=OneWay}" 
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           ToolTipService.ToolTip="{x:Bind ImagePath, Mode=OneWay}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind GeometryDisplay, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind Model, Mode=OneWay}" VerticalAlignment="Center" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Model, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Selected hard disk: one SettingsCard per concern, geometry tucked into a collapsed expander -->
                        <StackPanel Spacing="4"
                                    DataContext="{x:Bind ViewModel.SelectedHardDisk, Mode=OneWay}"
                                    IsHitTestVisible="{Binding Converter={StaticResource NotNullToBoolConverter}}">

                            <!-- Card 1: Bus and channel (channels used by another drive are disabled) -->
                            <controls:SettingsCard Header="Bus and channel"
                                                   Description="Every drive needs a channel of its own; channels already in use are unavailable.">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE968;" />
                                </controls:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox Width="110" AutomationProperties.Name="Bus"
                                              ItemsSource="{x:Bind ViewModel.HddBuses}"
                                              SelectedItem="{Binding Bus, Mode=TwoWay}" />
                                    <ComboBox Width="150" AutomationProperties.Name="Channel"
                                              ItemsSource="{Binding ChannelOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Name"
                                              SelectedValue="{Binding ChannelName, Mode=TwoWay}">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </StackPanel>
                            </controls:SettingsCard>

                            <!-- Card 2: Drive model -->
                            <controls:SettingsCard Header="Drive model"
                                                   Description="Sets the vendor, model and speed the guest sees.">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEDA2;" />
                                </controls:SettingsCard.HeaderIcon>
                                <AutoSuggestBox x:Name="HddModelBox" Width="340"
                                                Text="{Binding Model, Mode=OneWay}"
                                                PlaceholderText="Search drive models (vendor, model, size)…"
                                                QueryIcon="Find"
                                                GotFocus="OnHddModelGotFocus"
                                                TextChanged="OnHddModelTextChanged"
                                                SuggestionChosen="OnHddModelSuggestionChosen"
                                                QuerySubmitted="OnHddModelQuerySubmitted" />
                            </controls:SettingsCard>

                            <!-- Card 3: Disk image file -->
                            <controls:SettingsCard Header="Disk image file"
                                                   Description="The .vhd or .img file that holds this disk's data.">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Width="420">
                                    <TextBox Grid.Column="0" Text="{Binding ImagePath, Mode=TwoWay}"
                                             PlaceholderText="Path to .vhd / .img image file" />
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.BrowseDiskImageCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xED25;" FontSize="12" />
                                            <TextBlock Text="Browse" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </controls:SettingsCard>

                            <!-- Advanced drive geometry: collapsed by default -->
                            <controls:SettingsExpander Header="Advanced drive geometry (CHS)"
                                                       Description="Cylinders, heads and sectors. Change them only for a drive with a specific geometry."
                                                       IsExpanded="False">
                                <controls:SettingsExpander.HeaderIcon>
                                    <FontIcon Glyph="&#xE9D9;" />
                                </controls:SettingsExpander.HeaderIcon>
                                <controls:SettingsExpander.Items>
                                    <controls:SettingsCard Header="Cylinders">
                                        <NumberBox Width="140" Value="{Binding CylindersD, Mode=TwoWay}" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline" />
                                    </controls:SettingsCard>
                                    <controls:SettingsCard Header="Heads">
                                        <NumberBox Width="140" Value="{Binding HeadsD, Mode=TwoWay}" Minimum="1" Maximum="255" SpinButtonPlacementMode="Inline" />
                                    </controls:SettingsCard>
                                    <controls:SettingsCard Header="Sectors">
                                        <NumberBox Width="140" Value="{Binding SectorsD, Mode=TwoWay}" Minimum="1" Maximum="255" SpinButtonPlacementMode="Inline" />
                                    </controls:SettingsCard>
                                    <controls:SettingsCard Header="Size (MiB)">
                                        <NumberBox Width="140" Value="{Binding SizeMbD, Mode=TwoWay}" Minimum="1" Maximum="2097152" SpinButtonPlacementMode="Inline" />
                                    </controls:SettingsCard>
                                </controls:SettingsExpander.Items>
                            </controls:SettingsExpander>
                        </StackPanel>

                        <!-- Add Hard Disk (split button) + Remove Disk -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <SplitButton x:Name="AddHardDiskButton" Click="OnAddHardDiskClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add Hard Disk" />
                                </StackPanel>
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Text="Create New Hard Disk…" Click="OnCreateNewHardDiskClicked">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Attach Existing Image (.vhd, .img)…" Click="OnAttachExistingHardDiskClicked">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <Button Command="{x:Bind ViewModel.RemoveHardDiskCommand}"
                                    DataContext="{x:Bind ViewModel.SelectedHardDisk, Mode=OneWay}"
                                    IsEnabled="{Binding Converter={StaticResource NotNullToBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="Remove Disk" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 9. Floppy & CD-ROM Drives Category (Matches Screenshots 4 & 5) -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsFloppyCDROMCategory, Mode=OneWay}">
                        <!-- Category Header -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE958;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Floppy &amp; CD-ROM drives" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,-4,0,8" />

                        <!-- Subtab Switcher: Floppy drives / CD-ROM drives -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Click="OnSelectFloppyCDSubTab0" Padding="12,6" Style="{StaticResource SubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                        <TextBlock Text="Floppy drives" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnSelectFloppyCDSubTab1" Padding="12,6" Style="{StaticResource SubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE958;" FontSize="14" />
                                        <TextBlock Text="CD-ROM drives" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Subtab 0: Floppy drives (Screenshot 4) -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsFloppyCDSubTab0, Mode=OneWay}">
                            <!-- Floppy Drives Table -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <Grid RowDefinitions="Auto,*">
                                    <!-- Table Header -->
                                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1" Padding="12,6" CornerRadius="6,6,0,0">
                                        <Grid ColumnDefinitions="*,70,90">
                                            <TextBlock Grid.Column="0" Text="Type" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Grid.Column="1" Text="Turbo" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Grid.Column="2" Text="Check BPB" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </Border>

                                    <!-- Table List -->
                                    <ListView Grid.Row="1"
                                              ItemsSource="{x:Bind ViewModel.FloppyDrives}"
                                              SelectedItem="{x:Bind ViewModel.SelectedFloppyDrive, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              Padding="0" MinHeight="140">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="12,4" />
                                                <Setter Property="MinHeight" Value="32" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:FloppyDriveEntry">
                                                <Grid ColumnDefinitions="*,70,90" VerticalAlignment="Center">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" 
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                                  Opacity="{x:Bind IconOpacity, Mode=OneWay}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind Type, Mode=OneWay}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind TurboDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind CheckBpbDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- Floppy Drive Selected Details -->
                            <StackPanel Spacing="10" DataContext="{x:Bind ViewModel.SelectedFloppyDrive, Mode=OneWay}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" Width="50" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.FloppyTypes}"
                                              SelectedItem="{Binding Type, Mode=TwoWay}" />
                                    <CheckBox Grid.Column="2" Content="Turbo timings" IsChecked="{Binding Turbo, Mode=TwoWay}" />
                                    <CheckBox Grid.Column="3" Content="Check BPB" IsChecked="{Binding CheckBpb, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Audio:" VerticalAlignment="Center" Width="50" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.FloppyAudioOptions}"
                                              SelectedItem="{Binding Audio, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Subtab 1: CD-ROM drives (Screenshot 5) -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsFloppyCDSubTab1, Mode=OneWay}">
                            <!-- CD-ROM Drives Table -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <Grid RowDefinitions="Auto,*">
                                    <!-- Table Header -->
                                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1" Padding="12,6" CornerRadius="6,6,0,0">
                                        <Grid ColumnDefinitions="140,80,*">
                                            <TextBlock Grid.Column="0" Text="Bus" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Grid.Column="1" Text="Speed" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </Border>

                                    <!-- Table List -->
                                    <ListView Grid.Row="1"
                                              ItemsSource="{x:Bind ViewModel.CdromDrives}"
                                              SelectedItem="{x:Bind ViewModel.SelectedCdromDrive, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              Padding="0" MinHeight="160" MaxHeight="220">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="12,4" />
                                                <Setter Property="MinHeight" Value="30" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:CdromDriveEntry">
                                                <Grid ColumnDefinitions="140,80,*" VerticalAlignment="Center">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" 
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                                  Opacity="{x:Bind IconOpacity, Mode=OneWay}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind BusDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Speed, Mode=OneWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind TypeDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- CD-ROM Drive Selected Details -->
                            <StackPanel Spacing="10" DataContext="{x:Bind ViewModel.SelectedCdromDrive, Mode=OneWay}">
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Bus:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.CdromBusOptions}"
                                              SelectedItem="{Binding Bus, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="Channel:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.CdromChannelOptions}"
                                              SelectedItem="{Binding Channel, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="4" Text="Speed:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="5" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.CdromSpeeds}"
                                              SelectedItem="{Binding Speed, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.OpticalDriveModels}"
                                              SelectedValue="{Binding Type, Mode=TwoWay}"
                                              SelectedValuePath="InternalName"
                                              DisplayMemberPath="DisplayName" />
                                    <CheckBox Grid.Column="2" Content="Use EDC/ECC emulation" IsChecked="{Binding UseEdcEcc, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 10. Other Removable Devices Category (Matches User Screenshots) -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsOtherRemovableCategory, Mode=OneWay}">
                        <!-- Category Header -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE88E;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Other removable devices" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,-4,0,8" />

                        <!-- Subtab Switcher: MO drives / Removable disk drives / Tape drives -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Click="OnSelectOtherRemovableSubTab0" Padding="12,6" Style="{StaticResource SubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE93C;" FontSize="14" />
                                        <TextBlock Text="MO drives" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnSelectOtherRemovableSubTab1" Padding="12,6" Style="{StaticResource SubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE88E;" FontSize="14" />
                                        <TextBlock Text="Removable disk drives" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnSelectOtherRemovableSubTab2" Padding="12,6" Style="{StaticResource SubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE77C;" FontSize="14" />
                                        <TextBlock Text="Tape drives" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Subtab 0: MO drives (Screenshot 3) -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsOtherRemovableSubTab0, Mode=OneWay}">
                            <!-- MO Drives Table -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <Grid RowDefinitions="Auto,*">
                                    <!-- Table Header -->
                                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1" Padding="12,6" CornerRadius="6,6,0,0">
                                        <Grid ColumnDefinitions="160,*">
                                            <TextBlock Grid.Column="0" Text="Bus" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </Border>

                                    <!-- Table List -->
                                    <ListView Grid.Row="1"
                                              ItemsSource="{x:Bind ViewModel.MoDrives}"
                                              SelectedItem="{x:Bind ViewModel.SelectedMoDriveEntry, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              Padding="0" MinHeight="140">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="12,4" />
                                                <Setter Property="MinHeight" Value="32" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:GenericRemovableDriveEntry">
                                                <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" 
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                                  Opacity="{x:Bind IconOpacity, Mode=OneWay}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind BusDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind TypeDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- MO Drive Selected Details -->
                            <StackPanel Spacing="10" DataContext="{x:Bind ViewModel.SelectedMoDriveEntry, Mode=OneWay}">
                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Bus:" VerticalAlignment="Center" Width="40" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.RemovableBusOptions}"
                                              SelectedItem="{Binding Bus, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="Channel:" VerticalAlignment="Center" Width="60" />
                                    <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.RemovableChannelOptions}"
                                              SelectedItem="{Binding Channel, Mode=TwoWay}"
                                              IsEnabled="{Binding IsChannelEnabled, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" Width="40" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.MoDriveTypes}"
                                              SelectedItem="{Binding Type, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Subtab 1: Removable disk drives (Screenshot 2) -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsOtherRemovableSubTab1, Mode=OneWay}">
                            <!-- Removable Disk Drives Table -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <Grid RowDefinitions="Auto,*">
                                    <!-- Table Header -->
                                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1" Padding="12,6" CornerRadius="6,6,0,0">
                                        <Grid ColumnDefinitions="160,*">
                                            <TextBlock Grid.Column="0" Text="Bus" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </Border>

                                    <!-- Table List -->
                                    <ListView Grid.Row="1"
                                              ItemsSource="{x:Bind ViewModel.RemovableDrives}"
                                              SelectedItem="{x:Bind ViewModel.SelectedRemovableDriveEntry, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              Padding="0" MinHeight="140">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="12,4" />
                                                <Setter Property="MinHeight" Value="32" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:GenericRemovableDriveEntry">
                                                <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" 
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                                  Opacity="{x:Bind IconOpacity, Mode=OneWay}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind BusDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind TypeDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- Removable Disk Drive Selected Details -->
                            <StackPanel Spacing="10" DataContext="{x:Bind ViewModel.SelectedRemovableDriveEntry, Mode=OneWay}">
                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Bus:" VerticalAlignment="Center" Width="40" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.RemovableBusOptions}"
                                              SelectedItem="{Binding Bus, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="Channel:" VerticalAlignment="Center" Width="60" />
                                    <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.RemovableChannelOptions}"
                                              SelectedItem="{Binding Channel, Mode=TwoWay}"
                                              IsEnabled="{Binding IsChannelEnabled, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" Width="40" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.RemovableDriveTypes}"
                                              SelectedItem="{Binding Type, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Subtab 2: Tape drives (Screenshot 1) -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsOtherRemovableSubTab2, Mode=OneWay}">
                            <!-- Tape Drives Table -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <Grid RowDefinitions="Auto,*">
                                    <!-- Table Header -->
                                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1" Padding="12,6" CornerRadius="6,6,0,0">
                                        <Grid ColumnDefinitions="160,*">
                                            <TextBlock Grid.Column="0" Text="Bus" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </Border>

                                    <!-- Table List -->
                                    <ListView Grid.Row="1"
                                              ItemsSource="{x:Bind ViewModel.TapeDrives}"
                                              SelectedItem="{x:Bind ViewModel.SelectedTapeDriveEntry, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              Padding="0" MinHeight="140">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="12,4" />
                                                <Setter Property="MinHeight" Value="32" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:GenericRemovableDriveEntry">
                                                <Grid ColumnDefinitions="160,*" VerticalAlignment="Center">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" 
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                                  Opacity="{x:Bind IconOpacity, Mode=OneWay}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind BusDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind TypeDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- Tape Drive Selected Details -->
                            <StackPanel Spacing="10" DataContext="{x:Bind ViewModel.SelectedTapeDriveEntry, Mode=OneWay}">
                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Bus:" VerticalAlignment="Center" Width="40" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.TapeBusOptions}"
                                              SelectedItem="{Binding Bus, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="Channel:" VerticalAlignment="Center" Width="60" />
                                    <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.RemovableChannelOptions}"
                                              SelectedItem="{Binding Channel, Mode=TwoWay}"
                                              IsEnabled="{Binding IsChannelEnabled, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" Width="40" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.TapeDriveTypes}"
                                              SelectedItem="{Binding Type, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 11. Other Peripherals Category (the original's single page) -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsOtherPeripheralsCategory, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE772;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Other peripherals" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,-4,0,8" />

                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="ISA RTC:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.IsaRtcOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedIsaRtc, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85" Tag="ISA RTC" Click="OnConfigureDeviceClicked" />
                            </Grid>
                            <CheckBox Content="ISABugger device" IsChecked="{x:Bind ViewModel.EnableIsaBugger, Mode=TwoWay}" />
                            <CheckBox Content="POST card" IsChecked="{x:Bind ViewModel.EnablePostCard, Mode=TwoWay}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <CheckBox Grid.Column="0" Content="86Box Unit Tester" IsChecked="{x:Bind ViewModel.EnableUnitTester, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="Configure" MinWidth="85" Tag="Unit Tester" Click="OnConfigureDeviceClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <CheckBox Grid.Column="0" Content="Novell NetWare 2.x Key Card" IsChecked="{x:Bind ViewModel.EnableNovellKeyCard, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="Configure" MinWidth="85" Tag="Key Card" Click="OnConfigureDeviceClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <CheckBox Grid.Column="0" Content="Software-initiated poweroff device (IBM 5140)" IsChecked="{x:Bind ViewModel.EnableSoftPower, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="Configure" MinWidth="85" Tag="Soft Power" Click="OnConfigureDeviceClicked" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,2">
                                <TextBlock Text="Memory expansion cards" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Width="380" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Card 1:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.MemExpOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMemExp1, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85" Tag="Memory Expansion Card 1" Click="OnConfigureDeviceClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Card 2:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.MemExpOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMemExp2, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85" Tag="Memory Expansion Card 2" Click="OnConfigureDeviceClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Card 3:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.MemExpOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMemExp3, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85" Tag="Memory Expansion Card 3" Click="OnConfigureDeviceClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Card 4:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.MemExpOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMemExp4, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85" Tag="Memory Expansion Card 4" Click="OnConfigureDeviceClicked" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,2">
                                <TextBlock Text="ISA ROM Cards" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Width="380" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Card 1:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.IsaRomOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedIsaRom1, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85" Tag="ISA ROM Card 1" Click="OnConfigureDeviceClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Card 2:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.IsaRomOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedIsaRom2, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85" Tag="ISA ROM Card 2" Click="OnConfigureDeviceClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Card 3:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.IsaRomOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedIsaRom3, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85" Tag="ISA ROM Card 3" Click="OnConfigureDeviceClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Card 4:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.IsaRomOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedIsaRom4, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85" Tag="ISA ROM Card 4" Click="OnConfigureDeviceClicked" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 12. Advanced Category -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsAdvancedCategory, Mode=OneWay}">
                        <!-- Category Header -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Advanced" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,-4,0,8" />

                        <controls:SettingsCard Header="Configuration file"
                                               Description="Open this machine's 86box.cfg file in the default text editor"
                                               ActionIcon="{x:Null}">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </controls:SettingsCard.HeaderIcon>
                            <Button Content="Open file" Click="OnOpenConfigFileClicked" />
                        </controls:SettingsCard>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </NavigationView>

        <InfoBar Grid.Row="1" VerticalAlignment="Bottom" Margin="16" Severity="Error" IsClosable="False"
                 Title="Configuration not saved" Message="{x:Bind ViewModel.SaveErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}" />

        <!-- Custom footer: Save / Cancel, bottom-right, replacing the framework's full-width split
             button bar that PrimaryButtonText/CloseButtonText would otherwise have produced. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,0,24,20" Spacing="8">
            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" MinWidth="100" Click="OnSaveClicked" />
            <Button Content="Cancel" Style="{StaticResource DefaultButtonStyle}" MinWidth="100" Click="OnCancelClicked" />
        </StackPanel>

        <!-- In-page modal panel (replaces secondary ContentDialogs) -->
        <Grid x:Name="OverlayScrim" Grid.RowSpan="3" Visibility="Collapsed" Background="#99000000">
            <Border MaxWidth="560" MaxHeight="620" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
                    <TextBlock x:Name="OverlayTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <ContentPresenter x:Name="OverlayHost" Grid.Row="1" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button x:Name="OverlayPrimaryButton" Style="{StaticResource AccentButtonStyle}" MinWidth="110" Click="OnOverlayPrimaryClick" />
                        <Button x:Name="OverlayCloseButton" MinWidth="110" Click="OnOverlayCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
