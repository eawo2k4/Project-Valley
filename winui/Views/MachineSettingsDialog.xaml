<ContentDialog
    x:Class="Box86_WinUI.Views.MachineSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Box86_WinUI.Models"
    xmlns:viewmodels="using:Box86_WinUI.ViewModels"
    mc:Ignorable="d"
    CornerRadius="8">

    <!-- One ContentDialog holds the whole settings page. Sub-panels (New Hard Disk, device options, messages) are
         shown as an overlay on top of it, because WinUI allows only one ContentDialog to be open at a time. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1240</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
    </ContentDialog.Resources>

    <Grid x:Name="DialogRoot" x:FieldModifier="public" RowDefinitions="Auto,*,Auto">
        <!-- Custom header: Title/PrimaryButtonText/CloseButtonText are deliberately left unset above
             (a plain Content-only ContentDialog) so this and the footer below are the only chrome,
             instead of the framework's own full-width title/button bars. -->
        <TextBlock Grid.Row="0" Text="Machine Settings" Style="{StaticResource TitleTextBlockStyle}"
                   Margin="24,20,0,16" />

        <!-- Main Body: Windows 11 Modern Left NavigationView + Right Settings Container -->
        <NavigationView x:Name="SettingsNav" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        Background="Transparent"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Machine" Tag="Machine" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Display" Tag="Display">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Input devices" Tag="Input devices">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE961;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Sound" Tag="Sound">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Network" Tag="Network">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE839;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Ports (COM &amp; LPT)" Tag="Ports (COM &amp; LPT)">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Storage controllers" Tag="Storage controllers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC07;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Hard disks" Tag="Hard disks">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Floppy &amp; CD-ROM drives" Tag="Floppy &amp; CD-ROM drives">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE958;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Other removable devices" Tag="Other removable devices">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE88E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Other peripherals" Tag="Other peripherals">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE772;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Advanced" Tag="Advanced">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Settings Content Container inside ScrollViewer (Max-Width 800px Windows 11 Pattern) -->
            <ScrollViewer Padding="32,24,32,24">
                <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="16">

                    <!-- ========================================== -->
                    <!-- 1. Machine & Processor Category -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsMachineCategory, Mode=OneWay}">
                        <!-- Category Header -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Machine" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,-4,0,8" />

                        <!-- Section 1: Motherboard -->
                        <StackPanel Spacing="8">
                            <controls:SettingsCard Header="Machine Type (Era)"
                                                   Description="Hardware generation and socket classification">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE7F4;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox ItemsSource="{x:Bind ViewModel.MachineTypes}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMachineType, Mode=TwoWay}"
                                          MinWidth="260" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="Machine"
                                                   Description="Specific system board, chipset BIOS, and vendor">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEC05;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinWidth="340">
                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.AvailableMachines, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedMachine, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="Configure" />
                                </Grid>
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="Memory"
                                                   Description="Allocated volatile system memory capacity">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE950;" />
                                </controls:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox Value="{x:Bind ViewModel.MemoryMb, Mode=TwoWay}" 
                                               Minimum="{x:Bind ViewModel.MinRamMb, Mode=OneWay}" 
                                               Maximum="{x:Bind ViewModel.MaxRamMb, Mode=OneWay}" 
                                               SpinButtonPlacementMode="Compact" Width="140" />
                                    <TextBlock Text="MB" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="Time synchronization"
                                                   Description="Synchronize emulated real-time clock with host operating system">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE823;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox ItemsSource="{x:Bind ViewModel.TimeSyncOptions}"
                                          SelectedItem="{x:Bind ViewModel.SelectedTimeSyncOption, Mode=TwoWay}"
                                          MinWidth="220" />
                            </controls:SettingsCard>
                        </StackPanel>

                        <!-- Section 2: Processor (CPU) -->
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Processor" Margin="0,12,0,0" />
                        <StackPanel Spacing="8">
                            <controls:SettingsCard Header="CPU type"
                                                   Description="Central processing unit architecture and stepping">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE950;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableCpus, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedCpuType, Mode=TwoWay}"
                                          MinWidth="280" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="Frequency"
                                                   Description="Processor operational clock frequency in megahertz">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE77F;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFrequencies, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedFrequency, Mode=TwoWay}"
                                          MinWidth="160" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="FPU"
                                                   Description="Floating-point numeric math coprocessor">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE8EC;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFpus, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedFpu, Mode=TwoWay}"
                                          MinWidth="160" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="Wait states"
                                                   Description="Memory and I/O bus access cycle delay states">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE81C;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox ItemsSource="{x:Bind ViewModel.WaitStates}"
                                          SelectedItem="{x:Bind ViewModel.SelectedWaitState, Mode=TwoWay}"
                                          MinWidth="160" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="Softfloat FPU"
                                                   Description="Bit-accurate software floating-point calculation (High performance impact)">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE7BA;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.SoftfloatFpu, Mode=TwoWay}"
                                              OnContent="Enabled" OffContent="Disabled" />
                            </controls:SettingsCard>
                        </StackPanel>

                        <!-- Section 3: Performance -->
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Performance" Margin="0,12,0,0" />
                        <StackPanel Spacing="8">
                            <controls:SettingsCard Header="PIT mode"
                                                   Description="Timer interrupt emulation timing precision mode">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE916;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ComboBox ItemsSource="{x:Bind ViewModel.PitModes}"
                                          SelectedItem="{x:Bind ViewModel.SelectedPitMode, Mode=TwoWay}"
                                          MinWidth="220" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="Dynamic recompiler"
                                                   Description="Translate x86 machine instructions dynamically for peak host throughput">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE945;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.DynamicRecompiler, Mode=TwoWay}"
                                              OnContent="Enabled" OffContent="Disabled" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="Accurate FPU environment on the dynamic recompiler"
                                                   Description="Preserve exact FPU register states and flags during JIT execution">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.AccurateFpuEnvironment, Mode=TwoWay}"
                                              OnContent="Enabled" OffContent="Disabled" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="Use the 486 interpreter for 286 and 386 processors"
                                                   Description="Execute 286 and 386 workloads using the unified 486 execution pipeline">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE765;" />
                                </controls:SettingsCard.HeaderIcon>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.Use486InterpreterFor286_386, Mode=TwoWay}"
                                              OnContent="Enabled" OffContent="Disabled" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="CPU frame size"
                                                   Description="Frame scheduling quantum for smooth audio and video pacing">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE8B9;" />
                                </controls:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton Content="Smaller frames (smoother)" IsChecked="{x:Bind ViewModel.IsCpuFrameSizeSmaller, Mode=TwoWay}" />
                                    <RadioButton Content="Larger frames (less smooth)" IsChecked="{x:Bind ViewModel.IsCpuFrameSizeLarger, Mode=TwoWay}" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 2. Display Category -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsDisplayCategory, Mode=OneWay}">
                        <!-- Category Header -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Display" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,-4,0,8" />

                        <!-- Subtab Switcher: General / Monitor -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Click="OnSelectDisplaySubTab0" Padding="12,6" Style="{StaticResource SubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                                        <TextBlock Text="General" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnSelectDisplaySubTab1" Padding="12,6" Style="{StaticResource SubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE790;" FontSize="14" />
                                        <TextBlock Text="Monitor" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Subtab 0: General -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsDisplaySubTab0, Mode=OneWay}">
                            <!-- Video Row -->
                            <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Video:" VerticalAlignment="Center" />
                                <!-- Flat list, sorted newest-bus-first (AGP, PCI, VLB, ISA, MCA - see
                                     VideoBusGrouping in Models/VideoAdapterGroup.cs); each label already
                                     carries its own "[PCI]"/"[ISA]" bus tag. A CollectionViewSource with
                                     IsSourceGrouped="True" + GroupStyle here threw two different
                                     unrecoverable native exceptions (COMException "Element not found",
                                     then ArgumentException "The parameter is incorrect") on this WinAppSDK
                                     version, so real section headers were dropped in favour of this
                                     working, if plainer, ComboBox.SelectedItem binding every other combo
                                     box in this dialog already uses. -->
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.VideoAdapterOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedVideoCard, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85"
                                        Tag="Primary Video" Click="OnConfigureDeviceClicked" />
                            </Grid>

                            <!-- Video #2 Row -->
                            <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Video #2:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.SecondaryVideoCards, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedSecondaryVideoCard, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Configure" MinWidth="85"
                                        Tag="Secondary Video" Click="OnConfigureDeviceClicked" />
                            </Grid>

                            <!-- Voodoo 1 or 2 Graphics -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <CheckBox Grid.Column="0" Content="Voodoo 1 or 2 Graphics" 
                                          IsChecked="{x:Bind ViewModel.EnableVoodoo, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="Configure" MinWidth="85"
                                        IsEnabled="{x:Bind ViewModel.EnableVoodoo, Mode=OneWay}"
                                        Tag="3dfx Voodoo Graphics" Click="OnConfigureDeviceClicked" />
                            </Grid>

                            <!-- IBM 8514/A Graphics -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <CheckBox Grid.Column="0" Content="IBM 8514/A Graphics" 
                                          IsChecked="{x:Bind ViewModel.Enable8514, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="Configure" MinWidth="85"
                                        IsEnabled="{x:Bind ViewModel.Enable8514, Mode=OneWay}"
                                        Tag="IBM 8514/A" Click="OnConfigureDeviceClicked" />
                            </Grid>

                            <!-- XGA Graphics -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <CheckBox Grid.Column="0" Content="XGA Graphics" 
                                          IsChecked="{x:Bind ViewModel.EnableXga, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="Configure" MinWidth="85"
                                        IsEnabled="{x:Bind ViewModel.EnableXga, Mode=OneWay}"
                                        Tag="IBM XGA" Click="OnConfigureDeviceClicked" />
                            </Grid>

                            <!-- IBM PS/55 Display Adapter Graphics -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                <CheckBox Grid.Column="0" Content="IBM PS/55 Display Adapter Graphics"
                                          IsChecked="{x:Bind ViewModel.EnableDa2, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="Configure" MinWidth="85"
                                        IsEnabled="{x:Bind ViewModel.EnableDa2, Mode=OneWay}"
                                        Tag="IBM PS/55 DA2" Click="OnConfigureDeviceClicked" />
                            </Grid>

                            <!-- CRT post-process filter: a WinUI viewport rendering preference (not
                                 written to 86box.cfg - applies the same way to every machine). -->
                            <TextBlock Text="Viewport display filter" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,10,0,0" />

                            <Grid ColumnDefinitions="140,*" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Display filter:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DisplayFilterOptions}"
                                          SelectedItem="{x:Bind ViewModel.SelectedDisplayFilter, Mode=TwoWay}" />
                            </Grid>

                            <Grid ColumnDefinitions="140,*,50" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Screen curvature:" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="15" StepFrequency="1"
                                        Value="{x:Bind ViewModel.ScreenCurvaturePercent, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ScreenCurvaturePercent, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid ColumnDefinitions="140,*,50" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Phosphor bloom:" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{x:Bind ViewModel.PhosphorBloomPercent, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PhosphorBloomPercent, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock Text="Curvature and bloom only apply in Authentic CRT (Curved Glass) mode."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Subtab 1: Monitor -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsDisplaySubTab1, Mode=OneWay}">
                            <!-- VGA screen type -->
                            <Grid ColumnDefinitions="180,*" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="VGA screen type:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.ScreenTypes}"
                                          SelectedItem="{x:Bind ViewModel.SelectedScreenType, Mode=TwoWay}" />
                            </Grid>

                            <!-- Grayscale conversion type -->
                            <Grid ColumnDefinitions="180,*" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Grayscale conversion type:" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.GrayscaleConversions}"
                                          SelectedItem="{x:Bind ViewModel.SelectedGrayscaleConversion, Mode=TwoWay}" />
                            </Grid>

                            <!-- Monitor EDID Group -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14,10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Monitor EDID" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <RadioButton Content="Default" IsChecked="{x:Bind ViewModel.IsMonitorEdidDefault, Mode=TwoWay}" />
                                        <Button Content="Export…" Padding="12,4" Click="OnExportEdidClicked"
                                                ToolTipService.ToolTip="Write the built-in EDID to a file" />
                                        <Button Content="Profiles…" Padding="12,4" Tag="Monitor EDID" Click="OnConfigureDeviceClicked" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <RadioButton Content="Custom…" IsChecked="{x:Bind ViewModel.IsMonitorEdidCustom, Mode=TwoWay}" />
                                        <TextBox Text="{x:Bind ViewModel.CustomEdidPath, Mode=TwoWay}" PlaceholderText="Path to EDID file..." MinWidth="260"
                                                 IsEnabled="{x:Bind ViewModel.IsMonitorEdidCustom, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Overscan -->
                            <CheckBox Content="Overscan" IsChecked="{x:Bind ViewModel.EnableOverscan, Mode=TwoWay}" />

                            <!-- Inverted VGA monitor -->
                            <CheckBox Content="Inverted VGA monitor" IsChecked="{x:Bind ViewModel.InvertDisplay, Mode=TwoWay}" />

                            <!-- Change contrast for monochrome display -->
                            <CheckBox Content="Change contrast for monochrome display" IsChecked="{x:Bind ViewModel.MonochromeContrast, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 3. Input devices Category -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsInputCategory, Mode=OneWay}">
                        <!-- Category Header -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE961;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Input devices" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,-4,0,8" />

                        <!-- Keyboard Row -->
                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Keyboard:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.KeyboardTypes, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedKeyboardType, Mode=TwoWay}" />
                            <Button Grid.Column="2" Content="Configure" MinWidth="85"
                                    Tag="Keyboard" Click="OnConfigureDeviceClicked" />
                        </Grid>

                        <!-- Mouse Row -->
                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Mouse:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.MouseTypes, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedMouseType, Mode=TwoWay}" />
                            <Button Grid.Column="2" Content="Configure" MinWidth="85"
                                    Tag="Mouse" Click="OnConfigureDeviceClicked" />
                        </Grid>

                        <!-- Tablet Row -->
                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Tablet:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.TabletTypes, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedTabletType, Mode=TwoWay}" />
                            <Button Grid.Column="2" Content="Configure" MinWidth="85"
                                    Tag="Tablet" Click="OnConfigureDeviceClicked" />
                        </Grid>

                        <!-- Joystick Row -->
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Joystick:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Joysticks}"
                                      SelectedItem="{x:Bind ViewModel.SelectedJoystick1, Mode=TwoWay}" />
                        </Grid>

                        <!-- 4 Joystick Buttons Row -->
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="0,4,0,0">
                            <Button Grid.Column="0" Content="Joystick 1…" HorizontalAlignment="Stretch"
                                    Tag="Joystick 1" Click="OnConfigureDeviceClicked" />
                            <Button Grid.Column="1" Content="Joystick 2…" HorizontalAlignment="Stretch"
                                    Tag="Joystick 2" Click="OnConfigureDeviceClicked" />
                            <Button Grid.Column="2" Content="Joystick 3…" HorizontalAlignment="Stretch"
                                    Tag="Joystick 3" Click="OnConfigureDeviceClicked" />
                            <Button Grid.Column="3" Content="Joystick 4…" HorizontalAlignment="Stretch"
                                    Tag="Joystick 4" Click="OnConfigureDeviceClicked" />
                        </Grid>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 4. Sound Category -->
                    <!-- ========================================== -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsSoundCategory, Mode=OneWay}">
                        <!-- Category Header -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Sound" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,-4,0,8" />

                        <!-- Subtab Switcher: General / MIDI -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Click="OnSelectSoundSubTab0" Padding="12,6" Style="{StaticResource SubtleButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
