<ContentDialog
    x:Class="Box86_WinUI.Views.WelcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    CornerRadius="8">

    <!-- Title/PrimaryButtonText/CloseButtonText are deliberately left unset (a plain Content-only
         ContentDialog, same technique MachineSettingsDialog uses) so the OOBE-style split layout and
         its own bottom command bar are the only chrome, instead of the framework's title/button bars. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1040</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">680</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
    </ContentDialog.Resources>

    <Grid Width="1000" MinHeight="620" RowDefinitions="*,56">
        <!--
            No FlipView: its swipe/slide physics and hover chevrons are exactly what we suppressed
            last round, and it isn't built for a controlled crossfade anyway. The three slides are
            plain overlapping Grid children of TourHost (only one visible at a time); NavigateTo in
            the code-behind crossfades between them with a Storyboard instead of sliding.
        -->
        <Grid x:Name="TourHost" Grid.Row="0">

            <!-- Slide 1: Welcome -->
            <Grid x:Name="Slide1" ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Center" Margin="48,0,32,0">
                    <TextBlock Text="Welcome to 86Box" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="86Box faithfully emulates classic PCs down to the BIOS, chipset, and peripherals - from the original IBM PC through late-90s workstations."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Button Content="Get started" Style="{StaticResource AccentButtonStyle}"
                            Click="OnAdvanceClicked" HorizontalAlignment="Left" MinWidth="140" />
                </StackPanel>
                <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Image Source="ms-appx:///Assets/WelcomeHero.png" Height="220" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Slide 2: Preferences - real settings (ConfigService), not decorative toggles -->
            <Grid x:Name="Slide2" ColumnDefinitions="*,*" Opacity="0" Visibility="Collapsed">
                <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Center" Margin="48,0,32,0">
                    <TextBlock Text="A couple of preferences" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="You can always change these later in Settings."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Button Content="Continue" Style="{StaticResource AccentButtonStyle}"
                            Click="OnAdvanceClicked" HorizontalAlignment="Left" MinWidth="140" />
                </StackPanel>
                <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="32">
                    <StackPanel VerticalAlignment="Center" Spacing="12">
                        <controls:SettingsCard Header="Drive activity sounds"
                                               Description="Play a click when a floppy or hard disk is accessed">
                            <ToggleSwitch x:Name="DriveSoundsToggle" Toggled="OnDriveSoundsToggled" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="CRT scanline effect"
                                               Description="Apply a scanline filter to the emulated display">
                            <ToggleSwitch x:Name="CrtFilterToggle" Toggled="OnCrtFilterToggled" />
                        </controls:SettingsCard>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Slide 3: Completion -->
            <Grid x:Name="Slide3" ColumnDefinitions="*,*" Opacity="0" Visibility="Collapsed">
                <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Center" Margin="48,0,32,0">
                    <TextBlock Text="You're all set" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Create your first virtual machine from the VM Manager whenever you're ready."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Button Content="Launch 86Box" Style="{StaticResource AccentButtonStyle}"
                            Click="OnFinishClicked" HorizontalAlignment="Left" MinWidth="140" />
                </StackPanel>
                <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <!-- Layered glow (two widening, fading rings) behind a solid badge, sized to
                         roughly match slide 1's 220px hero image so the visual weight is consistent. -->
                    <Grid Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="220" Height="220" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.12" />
                        <Ellipse Width="168" Height="168" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.22" />
                        <Border Width="128" Height="128" CornerRadius="64"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="56" Foreground="White" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom command bar: Home far left, Prev/Next far right. Stays static through the
             crossfade above - it lives in its own Grid row, untouched by the slide animation. -->
        <Grid Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
              Padding="16,0" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Style="{StaticResource SubtleButtonStyle}"
                    Click="OnHomeClicked" ToolTipService.ToolTip="Back to start" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE80F;" FontSize="14" />
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PrevButton" Style="{StaticResource SubtleButtonStyle}"
                        Click="OnPrevClicked" ToolTipService.ToolTip="Previous">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource SubtleButtonStyle}"
                        Click="OnNextClicked" ToolTipService.ToolTip="Next">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
