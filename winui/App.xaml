<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Box86_WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Box86_WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The TitleBar control's default template caps its icon at 16x16 DIP via these theme
                resources (see Microsoft.WinUI generic.xaml) - it hard-clamps the icon inside a Viewbox
                regardless of the source image's own size, which is why no image-side fix ever made
                the titlebar icon look bigger. Overriding the keys here is the sanctioned way to resize
                it without re-templating the whole control.
            -->
            <x:Double x:Key="TitleBarIconMaxWidth">24</x:Double>
            <x:Double x:Key="TitleBarIconMaxHeight">24</x:Double>

            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:InvertedNullToVisibilityConverter x:Key="InvertedNullToVisibilityConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:StatusToInfoBadgeStyleConverter x:Key="StatusToInfoBadgeStyleConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:StatusToForegroundBrushConverter x:Key="StatusToForegroundBrushConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:ActivityToBrushConverter x:Key="ActivityToBrushConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:DeviceActivityBrushConverter x:Key="DeviceActivityBrushConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:SpeedToForegroundBrushConverter x:Key="SpeedToForegroundBrushConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:SpeedToBackgroundBrushConverter x:Key="SpeedToBackgroundBrushConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:CategoryToIconConverter x:Key="CategoryToIconConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:BoolToTabBgConverter x:Key="BoolToTabBgConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:BoolToTabBorderConverter x:Key="BoolToTabBorderConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" xmlns:converters="using:Box86_WinUI.Converters" />
            <converters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" xmlns:converters="using:Box86_WinUI.Converters" />

            <!-- Windows 11 Fluent Neutral Dot InfoBadge Style for Stopped VMs -->
            <Style x:Key="NeutralDotInfoBadgeStyle" TargetType="InfoBadge" BasedOn="{StaticResource InformationalDotInfoBadgeStyle}">
                <Setter Property="Background" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <!-- Standard destructive action button style adhering to Fluent Design -->
            <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <!-- Standard Subtle DropDownButton style adhering to Windows 11 Fluent UX -->
            <Style x:Key="SubtleDropDownButtonStyle" TargetType="DropDownButton">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
