<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Box86_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Box86_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="86Box VM Manager"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="86Box VM Manager" Grid.Row="0">
            <TitleBar.IconSource>
                <!--
                    Plain 32x32 PNG, not the multi-frame .ico: WIC's frame-selection heuristic for a
                    multi-resolution .ico plus a forced DecodePixelWidth was the actual source of the
                    blur/undersize, not the DPI math. A single well-cropped raster with no decode-size
                    override lets the TitleBar control's own Image element size and scale it normally.
                -->
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.targetsize-32_altform-unplated.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Top-docked Fluent Update InfoBar -->
        <InfoBar x:Name="UpdateNotificationInfoBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsIconVisible="True"
                 Margin="12,2,12,6" />

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="2">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition />
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
    </Grid>
</Window>
